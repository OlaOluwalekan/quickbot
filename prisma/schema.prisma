generator client {
  provider = "prisma-client"
  output   = "../server/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectRole {
  VIEWER
  COMMENTER
  EDITOR
  ADMIN
}

enum WorkspaceRole {
  VIEWER
  COMMENTER
  EDITOR
  ADMIN
}

enum TitleSource {
  AUTO
  USER
}

model User {
  id                   String            @id
  name                 String
  email                String            @unique
  emailVerified        Boolean           @default(false)
  image                String?
  role                 UserRole          @default(USER)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  accounts             Account[]
  projects             Project[]
  workspaces           Workspace[]
  projectMemberships   ProjectMember[]
  workspaceMemberships WorkspaceMember[]
  creditAccount        CreditAccount?
  preference           UserPreference?
  supportTickets       SupportTicket[]
  attachments          Attachment[]        @relation("UserAttachments")
  annotations          Annotation[]        @relation("AnnotationCreator")
  annotationMessages   AnnotationMessage[] @relation("AnnotationMessageAuthor")
  promotions           Promotion[]         @relation("PromotionCreator")
  username             String?             @unique
  displayUsername      String?             @map("display_username")
  usernameChangeCount  Int                 @default(0) @map("username_change_count")
  usernameChangedAt    DateTime?           @map("username_changed_at")
  usernameClaimedAt    DateTime?           @map("username_claimed_at")
  auditLogs            AuditLog[]
  avatarAttachmentId   String?             @unique @map("avatar_attachment_id")
  avatarAttachment     Attachment?         @relation("UserAvatarAttachment", fields: [avatarAttachmentId], references: [id], onDelete: SetNull)
  sentInvitations      Invitation[]        @relation("SentInvitations")
  receivedInvitations  Invitation[]        @relation("ReceivedInvitations")
  activityLogs         ActivityLog[]       @relation("ActorActivityLogs")
  createdShareLinks    ShareLink[]         @relation("CreatedShareLinks")
  notifications        Notification[]
  sentTransfers        OwnershipTransfer[] @relation("TransfersSent")
  receivedTransfers    OwnershipTransfer[] @relation("TransfersReceived")
  memberLimitGrace     MemberLimitGrace?
  annotationMentions   AnnotationMention[]

  @@map("users")
}

model Session {
  id          String   @id
  userId      String
  token       String   @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  country     String?
  deviceLabel String?
  client      String?  @default("web")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Project {
  id          String          @id @default(uuid(7))
  ownerId     String
  name        String
  description String?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces  Workspace[]
  members     ProjectMember[]
  invitations Invitation[]
  activityLogs ActivityLog[]
  ownershipTransfers   OwnershipTransfer[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc)])
  @@map("projects")
}

model Workspace {
  id             String            @id @default(uuid(7))
  ownerId        String
  projectId      String?
  title          String
  titleSource    TitleSource       @default(AUTO)
  archivedAt     DateTime?
  deletedAt      DateTime?
  lastActivityAt DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members        WorkspaceMember[]
  responses      Response[]
  generations    Generation[]
  attachments    Attachment[]
  annotations    Annotation[]
  invitations    Invitation[]
  activityLogs   ActivityLog[]
  shareLinks     ShareLink[]
  ownershipTransfers   OwnershipTransfer[]
  notes          WorkspaceNote[]

  @@index([ownerId, deletedAt, lastActivityAt(sort: Desc)])
  @@index([projectId, deletedAt])
  @@map("workspaces")
}

model ProjectMember {
  id               String      @id @default(uuid(7))
  projectId        String
  userId           String
  role             ProjectRole
  monthlyCreditCap Int?        @default(300) @map("monthly_credit_cap")
  canComment       Boolean?    @map("can_comment")
  canAsk           Boolean?    @map("can_ask")
  suspendedAt      DateTime?   @map("suspended_at")
  suspendedReason  String?     @map("suspended_reason")
  keepActive       Boolean     @default(false) @map("keep_active")
  invitedById      String
  createdAt        DateTime    @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model WorkspaceMember {
  id               String        @id @default(uuid(7))
  workspaceId      String
  userId           String
  role             WorkspaceRole
  monthlyCreditCap Int?          @default(300) @map("monthly_credit_cap")
  canComment       Boolean?      @map("can_comment")
  canAsk           Boolean?      @map("can_ask")
  suspendedAt      DateTime?     @map("suspended_at")
  suspendedReason  String?       @map("suspended_reason")
  keepActive       Boolean     @default(false) @map("keep_active")
  invitedById      String
  createdAt        DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum LedgerType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
  REFUND
  EXPIRE
  ADJUST
}

model CreditAccount {
  id           String         @id @default(uuid(7))
  userId       String         @unique @map("user_id")
  planBalance  Int            @default(0) @map("plan_balance")
  topupBalance Int            @default(0) @map("topup_balance")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger       CreditLedger[]

  @@map("credit_accounts")
}

model CreditLedger {
  id             String        @id @default(uuid(7))
  accountId      String        @map("account_id")
  type           LedgerType
  planDelta      Int           @map("plan_delta")
  topupDelta     Int           @map("topup_delta")
  planAfter      Int           @map("plan_after")
  topupAfter     Int           @map("topup_after")
  generationId   String?       @map("generation_id")
  actorId        String?       @map("actor_id")
  reason         String?
  estimated      Boolean       @default(false)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  account        CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([generationId])
  @@map("credit_ledger")
}


enum ResponseKind {
  TEXT
  IMAGE
}

enum ResponseOrigin {
  DIRECT
  PROMOTED
}

enum VersionStatus {
  STREAMING
  COMPLETE
  FAILED
}

model Response {
  id              String            @id @default(uuid(7))
  workspaceId     String            @map("workspace_id")
  createdById     String            @map("created_by_id")
  prompt          String            @db.Text
  kind            ResponseKind      @default(TEXT)
  origin          ResponseOrigin    @default(DIRECT)
  sortAt          DateTime          @default(now()) @map("sort_at")
  activeVersionId String?           @unique @map("active_version_id")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions        ResponseVersion[]
  attachments     Attachment[]
  annotations     Annotation[]
  shareLinks      ShareLink[]
  quote           String?           @db.Text
  sourceAnnotationId String?        @map("source_annotation_id")

  @@index([workspaceId, deletedAt, sortAt, id])
  @@map("responses")
}

model ResponseVersion {
  id              String         @id @default(uuid(7))
  responseId      String         @map("response_id")
  number          Int
  status          VersionStatus  @default(STREAMING)
  content         String         @default("") @db.Text
  thoughtSummary  String?        @map("thought_summary") @db.Text
  modelKey        String         @map("model_key")
  providerModelId String         @map("provider_model_id")
  promptVersion   String         @map("prompt_version")
  generationId    String?        @unique @map("generation_id")
  sourceMessageId String?        @map("source_message_id")
  createdById     String         @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  response        Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  edits           ResponseEdit[]
  citations       Citation[]
  annotations     Annotation[]

  @@unique([responseId, number])
  @@index([responseId, createdAt])
  @@index([sourceMessageId])
  @@map("response_versions")
}

model ResponseEdit {
  id        String          @id @default(uuid(7))
  versionId String          @map("version_id")
  revision  Int
  content   String          @db.Text
  editorId  String          @map("editor_id")
  createdAt DateTime        @default(now()) @map("created_at")
  version   ResponseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, revision])
  @@map("response_edits")
}


enum GenStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum GenKind {
  TEXT
  IMAGE
  ANNOTATION_REPLY
  QUESTION_BATCH
  TITLE
  SPEECH
}

model Generation {
  id              String      @id @default(uuid(7))
  workspaceId     String      @map("workspace_id")
  responseId      String?     @map("response_id")
  versionId       String?     @map("version_id")
  actorId         String      @map("actor_id")
  billedAccountId String      @map("billed_account_id")
  kind            GenKind
  status          GenStatus   @default(QUEUED)
  modelKey        String      @map("model_key")
  providerModelId String      @map("provider_model_id")
  promptVersion   String      @map("prompt_version")
  idempotencyKey  String      @map("idempotency_key")
  reservedCredits Int         @default(0) @map("reserved_credits")
  chargedCredits  Int         @default(0) @map("charged_credits")
  usage           Json?
  errorCode       String?     @map("error_code")
  startedAt       DateTime?   @map("started_at")
  finishedAt      DateTime?   @map("finished_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([actorId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([status, startedAt])
  @@index([billedAccountId, createdAt])
  @@index([billedAccountId, actorId, createdAt])
  @@map("generations")
}

model UserPreference {
  userId            String   @id @map("user_id")
  uiLocale          String?  @map("ui_locale")
  aiLanguage        String?  @map("ai_language")
  notificationPrefs Json?    @map("notification_prefs")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(uuid(7))
  userId      String?      @map("user_id")
  email       String
  topic       String
  message     String       @db.Text
  diagnostics Json?
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
  GENERATED_IMAGE
  GENERATED_DOCUMENT
  AVATAR
  AUDIO
}

enum AttachmentStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

model Attachment {
  id            String           @id @default(uuid(7))
  ownerId       String           @map("owner_id")
  workspaceId   String?          @map("workspace_id")
  responseId    String?          @map("response_id")
  kind          AttachmentKind
  status        AttachmentStatus @default(PENDING)
  providerId    String           @map("provider_id")
  resourceType  String           @map("resource_type")
  mime          String
  bytes         Int
  width         Int?
  height        Int?
  originalName  String           @map("original_name")
  sha256        String?
  extractedText String?          @map("extracted_text") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  deletedAt     DateTime?        @map("deleted_at")

  user       User       @relation("UserAttachments", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarUser User?      @relation("UserAvatarAttachment")
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  response  Response?  @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([ownerId])
  @@index([status, createdAt])
  @@map("attachments")
}

enum CitationSource {
  GROUNDING
  ATTACHMENT
  MODEL_PROVIDED
}

model Citation {
  id        String          @id @default(uuid(7))
  versionId String          @map("version_id")
  index     Int
  url       String
  title     String?
  snippet   String?         @db.Text
  source    CitationSource  @default(GROUNDING)
  createdAt DateTime        @default(now()) @map("created_at")

  version   ResponseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, index])
  @@index([versionId])
  @@map("citations")
}

enum AnnotationKind {
  COMMENT
  ASK
}

enum AnnotationTarget {
  RESPONSE_VERSION
  ANNOTATION_MESSAGE
  DOCUMENT_REVISION
}

enum AuthorType {
  USER
  AI
}

enum SuggestionState {
  PENDING
  ACCEPTED
  REJECTED
  STALE
}

enum QuestionState {
  NONE
  QUEUED
  ANSWERING
  ANSWERED
  CANCELLED
  FAILED
}

enum Visibility {
  PRIVATE
  WORKSPACE
}

enum ContentSource {
  ORIGINAL
  EDIT
}

enum MsgRole {
  USER
  ASSISTANT
}

model Annotation {
  id                 String              @id @default(uuid(7))
  workspaceId        String              @map("workspace_id")
  responseId         String?             @map("response_id")
  versionId          String?             @map("version_id")
  targetType         AnnotationTarget    @default(RESPONSE_VERSION) @map("target_type")
  targetMessageId    String?             @map("target_message_id")
  documentId         String?             @map("document_id")
  documentRevision   Int?                @map("document_revision")
  parentAnnotationId String?             @map("parent_annotation_id")
  rootAnnotationId   String?             @map("root_annotation_id")
  depth              Int                 @default(0)
  authorType         AuthorType          @default(USER) @map("author_type")
  suggestion         Json?
  suggestionState    SuggestionState?    @map("suggestion_state")
  contentSource      ContentSource       @default(ORIGINAL) @map("content_source")
  editRevision       Int?                @map("edit_revision")
  createdById        String              @map("created_by_id")
  kind               AnnotationKind
  questionState      QuestionState       @default(NONE) @map("question_state")
  visibility         Visibility          @default(PRIVATE)
  resolvedAt         DateTime?           @map("resolved_at")
  deletedAt          DateTime?           @map("deleted_at")
  anchorExact        String              @map("anchor_exact") @db.Text
  anchorPrefix       String              @map("anchor_prefix")
  anchorSuffix       String              @map("anchor_suffix")
  anchorStart        Int?                @map("anchor_start")
  anchorEnd          Int?                @map("anchor_end")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  response           Response?           @relation(fields: [responseId], references: [id], onDelete: Cascade)
  version            ResponseVersion?    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("AnnotationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  targetMessage      AnnotationMessage?  @relation("AnnotationsOnMessage", fields: [targetMessageId], references: [id], onDelete: Cascade)
  parent             Annotation?         @relation("AnnotationChildren", fields: [parentAnnotationId], references: [id], onDelete: Cascade)
  children           Annotation[]        @relation("AnnotationChildren")
  messages           AnnotationMessage[] @relation("AnnotationThreadMessages")
  promotions         Promotion[]
  notes              WorkspaceNote[]

  @@index([versionId, deletedAt])
  @@index([workspaceId, createdById, questionState])
  @@index([responseId])
  @@index([targetMessageId, deletedAt])
  @@index([rootAnnotationId])
  @@map("annotations")
}

model AnnotationMessage {
  id             String              @id @default(uuid(7))
  annotationId   String              @map("annotation_id")
  role           MsgRole
  content        String              @db.Text
  authorId       String?             @map("author_id")
  generationId   String?             @unique @map("generation_id")
  thoughtSummary String?             @map("thought_summary") @db.Text
  citations      Json?
  status         String              @default("COMPLETE")
  modelKey       String?             @map("model_key")
  createdAt      DateTime            @default(now()) @map("created_at")

  annotation     Annotation          @relation("AnnotationThreadMessages", fields: [annotationId], references: [id], onDelete: Cascade)
  author         User?               @relation("AnnotationMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  promotions     Promotion[]
  annotationsOn  Annotation[]        @relation("AnnotationsOnMessage")
  mentions       AnnotationMention[]

  @@index([annotationId, createdAt])
  @@map("annotation_messages")
}

model AnnotationMention {
  id        String            @id @default(uuid(7))
  messageId String            @map("message_id")
  userId    String?           @map("user_id")
  isKlecx   Boolean           @default(false) @map("is_klecx")
  createdAt DateTime          @default(now()) @map("created_at")
  message   AnnotationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("annotation_mentions")
}

enum NoteStatus {
  ACTIVE
  ARCHIVED
}

model WorkspaceNote {
  id           String     @id @default(uuid(7))
  workspaceId  String     @map("workspace_id")
  annotationId String     @map("annotation_id")
  messageId    String     @unique @map("message_id")
  createdById  String     @map("created_by_id")
  quote        String     @db.Text
  instruction  String     @db.Text
  status       NoteStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  archivedAt   DateTime?  @map("archived_at")
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  annotation   Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([annotationId])
  @@map("workspace_notes")
}

enum PromotionTarget {
  TIMELINE
  NEW_WORKSPACE
}

model Promotion {
  id                     String            @id @default(uuid(7))
  annotationId           String            @map("annotation_id")
  messageId              String            @map("message_id")
  target                 PromotionTarget
  destinationResponseId  String?           @map("destination_response_id")
  destinationWorkspaceId String?           @map("destination_workspace_id")
  createdById            String            @map("created_by_id")
  createdAt              DateTime          @default(now()) @map("created_at")

  annotation             Annotation        @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  message                AnnotationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy              User              @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([messageId, target])
  @@index([annotationId])
  @@index([destinationResponseId])
  @@index([destinationWorkspaceId])
  @@map("promotions")
}

model AuditLog {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  action    String
  targetId  String?  @map("target_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id            String       @id @default(uuid(7))
  workspaceId   String?      @map("workspace_id")
  projectId     String?      @map("project_id")
  email         String
  invitedUserId String?      @map("invited_user_id")
  role          String
  tokenHash     String       @unique @map("token_hash")
  status        InviteStatus @default(PENDING)
  invitedById   String       @map("invited_by_id")
  expiresAt     DateTime     @map("expires_at")
  acceptedAt    DateTime?    @map("accepted_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  workspace     Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy     User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser   User?        @relation("ReceivedInvitations", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([workspaceId])
  @@index([projectId])
  @@map("invitations")
}

model ActivityLog {
  id          String     @id @default(uuid(7))
  workspaceId String?    @map("workspace_id")
  projectId   String?    @map("project_id")
  actorId     String     @map("actor_id")
  action      String
  targetType  String?    @map("target_type")
  targetId    String?    @map("target_id")
  meta        Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User       @relation("ActorActivityLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("activity_log")
}

enum ShareScope {
  WORKSPACE
  RESPONSE
}

model ShareLink {
  id           String     @id @default(uuid(7))
  workspaceId  String     @map("workspace_id")
  responseId   String?    @map("response_id")
  scope        ShareScope
  view         String     @default("EDITED_IF_AVAILABLE")
  tokenHash    String     @unique @map("token_hash")
  tokenPrefix  String     @map("token_prefix")
  showAuthor   Boolean    @default(false) @map("show_author")
  expiresAt    DateTime?  @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  viewCount    Int        @default(0) @map("view_count")
  lastViewedAt DateTime?  @map("last_viewed_at")

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  response     Response?  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("CreatedShareLinks", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("share_links")
}

enum NotifStatus {
  UNREAD
  READ
  DISMISSED
}

enum EmailStatus {
  NONE
  PENDING
  SENT
  FAILED
}

model Notification {
  id          String      @id @default(uuid(7))
  userId      String      @map("user_id")
  type        String
  payload     Json
  dedupeKey   String?     @map("dedupe_key")
  status      NotifStatus @default(UNREAD)
  emailStatus EmailStatus @default(NONE) @map("email_status")
  createdAt   DateTime    @default(now()) @map("created_at")
  readAt      DateTime?   @map("read_at")
  dismissedAt DateTime?   @map("dismissed_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("notifications")
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

model OwnershipTransfer {
  id                  String         @id @default(uuid(7))
  workspaceId         String?        @map("workspace_id")
  projectId           String?        @map("project_id")
  fromUserId          String         @map("from_user_id")
  toUserId            String         @map("to_user_id")
  previousOwnerAction String         @default("STAY_ADMIN") @map("previous_owner_action")
  status              TransferStatus @default(PENDING)
  expiresAt           DateTime       @map("expires_at")
  respondedAt         DateTime?      @map("responded_at")
  createdAt           DateTime       @default(now()) @map("created_at")

  workspace           Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromUser            User           @relation("TransfersSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser              User           @relation("TransfersReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([workspaceId])
  @@index([projectId])
  @@map("ownership_transfers")
}

model MemberLimitGrace {
  id          String   @id @default(uuid(7))
  ownerId     String   @unique @map("owner_id")
  limit       Int
  graceEndsAt DateTime @map("grace_ends_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("member_limit_grace")
}
