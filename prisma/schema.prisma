generator client {
  provider = "prisma-client"
  output   = "../server/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectRole {
  VIEWER
  COMMENTER
  EDITOR
  ADMIN
}

enum WorkspaceRole {
  NONE
  VIEWER
  COMMENTER
  EDITOR
  ADMIN
}

enum TitleSource {
  AUTO
  USER
}

model User {
  id                   String            @id
  name                 String
  email                String            @unique
  emailVerified        Boolean           @default(false)
  image                String?
  role                 UserRole          @default(USER)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  accounts             Account[]
  projects             Project[]
  workspaces           Workspace[]
  projectMemberships   ProjectMember[]
  workspaceMemberships WorkspaceMember[]
  creditAccount        CreditAccount?

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Project {
  id          String          @id @default(uuid(7))
  ownerId     String
  name        String
  description String?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces  Workspace[]
  members     ProjectMember[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc)])
  @@map("projects")
}

model Workspace {
  id             String            @id @default(uuid(7))
  ownerId        String
  projectId      String?
  title          String
  titleSource    TitleSource       @default(AUTO)
  archivedAt     DateTime?
  deletedAt      DateTime?
  lastActivityAt DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members        WorkspaceMember[]

  @@index([ownerId, deletedAt, lastActivityAt(sort: Desc)])
  @@index([projectId, deletedAt])
  @@map("workspaces")
}

model ProjectMember {
  id          String      @id @default(uuid(7))
  projectId   String
  userId      String
  role        ProjectRole
  invitedById String
  createdAt   DateTime    @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model WorkspaceMember {
  id          String        @id @default(uuid(7))
  workspaceId String
  userId      String
  role        WorkspaceRole
  invitedById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum LedgerType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
  REFUND
  EXPIRE
  ADJUST
}

model CreditAccount {
  id           String         @id @default(uuid(7))
  userId       String         @unique @map("user_id")
  planBalance  Int            @default(0) @map("plan_balance")
  topupBalance Int            @default(0) @map("topup_balance")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger       CreditLedger[]

  @@map("credit_accounts")
}

model CreditLedger {
  id             String        @id @default(uuid(7))
  accountId      String        @map("account_id")
  type           LedgerType
  planDelta      Int           @map("plan_delta")
  topupDelta     Int           @map("topup_delta")
  planAfter      Int           @map("plan_after")
  topupAfter     Int           @map("topup_after")
  generationId   String?       @map("generation_id")
  actorId        String?       @map("actor_id")
  reason         String?
  estimated      Boolean       @default(false)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  account        CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([generationId])
  @@map("credit_ledger")
}
